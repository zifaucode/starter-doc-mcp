{
  "name": "starter-doc-mcp",
  "version": "1.1.1",
  "description": "MCP server that generates PRD, SRS, ERD, SDD, DESIGN, traceability matrix, and agent instructions as Markdown, so coding agents build from written specs instead of guessing.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "starter-doc-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zifaucode/starter-doc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zifaucode/starter-doc-mcp/issues"
  },
  "homepage": "https://github.com/zifaucode/starter-doc-mcp#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "tsx --test tests/suite.test.ts tests/fileWriter.test.ts tests/paths.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "srs",
    "prd",
    "erd",
    "sdd",
    "system-design",
    "software-architecture",
    "ai-agents",
    "anti-hallucination"
  ],
  "author": "ZIFAU",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
